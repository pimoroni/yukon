diff --git a/extmod/btstack/btstack.cmake b/extmod/btstack/btstack.cmake
index dd416fcbf..7a45b4251 100644
--- a/extmod/btstack/btstack.cmake
+++ b/extmod/btstack/btstack.cmake
@@ -58,3 +58,12 @@ target_sources(micropy_extmod_btstack INTERFACE
     ${BTSTACK_LIB_DIR}/src/l2cap.c
     ${BTSTACK_LIB_DIR}/src/l2cap_signaling.c
 )
+
+# Bluetooth Classic, with the HID host for game pads and the SDP client it discovers them with.
+if(MICROPY_BLUETOOTH_BTSTACK_CLASSIC)
+    target_sources(micropy_extmod_btstack INTERFACE
+        ${BTSTACK_LIB_DIR}/src/classic/hid_host.c
+        ${BTSTACK_LIB_DIR}/src/classic/sdp_client.c
+        ${BTSTACK_LIB_DIR}/src/classic/sdp_util.c
+    )
+endif()
diff --git a/extmod/btstack/modbluetooth_btstack.c b/extmod/btstack/modbluetooth_btstack.c
index 7694a1874..761eb10bc 100644
--- a/extmod/btstack/modbluetooth_btstack.c
+++ b/extmod/btstack/modbluetooth_btstack.c
@@ -646,6 +646,12 @@ int mp_bluetooth_init(void) {
     // Register for ATT server events.
     att_server_register_packet_handler(&btstack_packet_handler_att_server);
 
+    #if MICROPY_BLUETOOTH_BTSTACK_CLASSIC
+    // Let the board's Classic support register its services before the controller powers on, so
+    // a device that pages straight after activation finds it listening.
+    mp_bluetooth_btstack_classic_init();
+    #endif
+
     // Set a timeout for HCI initialisation.
     btstack_run_loop_set_timer(&btstack_init_deinit_timeout, BTSTACK_INIT_DEINIT_TIMEOUT_MS);
     btstack_run_loop_set_timer_handler(&btstack_init_deinit_timeout, btstack_init_deinit_timeout_handler);
