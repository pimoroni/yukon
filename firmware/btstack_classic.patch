index 7f4a18207..5a8a5441d 100644
--- a/extmod/btstack/modbluetooth_btstack.h
+++ b/extmod/btstack/modbluetooth_btstack.h
@@ -51,6 +51,12 @@ typedef struct _mp_bluetooth_btstack_root_pointers_t {
     #endif
 } mp_bluetooth_btstack_root_pointers_t;
 
+#if MICROPY_BLUETOOTH_BTSTACK_CLASSIC
+// Provided by the board's Classic support. Called from mp_bluetooth_init after l2cap_init and
+// before the controller powers on, on every activation.
+void mp_bluetooth_btstack_classic_init(void);
+#endif
+
 enum {
     MP_BLUETOOTH_BTSTACK_STATE_OFF,
     MP_BLUETOOTH_BTSTACK_STATE_STARTING,
